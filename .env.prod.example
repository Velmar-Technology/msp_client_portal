# =========================================================================
# Velmar Technology SRL MSP Help Desk — Production Environment Variables
# =========================================================================
# Copy this file to .env in your VPS deployment folder (~/msp-client-portal/.env)

# and fill in the production secrets.

# ---- Docker Image settings ----
# Set this to your GitHub username or organization (lowercase)
REPOSITORY_OWNER=eapolancovelmar

# ---- Database ----
# Note: Host must match the DB service name in docker-compose.prod.yml (which is 'db')
DB_HOST=db
DB_PORT=5432
DB_NAME=msp_helpdesk
DB_USER=postgres
DB_PASSWORD=choose_a_strong_password_here

# ---- Server Configuration ----
PORT=3001
NODE_ENV=production

# ---- Initial Admin Credentials ----
ADMIN_EMAIL=admin@msp-services.com
# Change password123 to a strong, secure password in production
ADMIN_PASSWORD=password123

# ---- JWT Token Config ----
JWT_SECRET=generate_a_random_32_character_hex_secret_here
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=generate_another_random_32_character_hex_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# ---- CORS Origin ----
# Set this to the external production URL of your portal
CORS_ORIGIN=http://your-domain.com

# ---- File Uploads ----
UPLOAD_DIR=/app/server/uploads
MAX_FILE_SIZE_MB=10

# ---- Email (Nodemailer) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_production_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# ---- WhatsApp (API Integration) ----
WHATSAPP_API_URL=https://api.whatsapp.example.com
WHATSAPP_API_KEY=your_production_whatsapp_api_key

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=your_production_google_client_id

# ---- PayPal Integration ----
PAYPAL_CLIENT_ID=your_production_paypal_client_id
PAYPAL_CLIENT_SECRET=your_production_paypal_client_secret

# ---- Nextcloud Integration ----
NEXTCLOUD_URL=https://nextcloud.your-domain.com
NEXTCLOUD_APP_USER=your_nextcloud_admin_username
NEXTCLOUD_APP_PASS=your_nextcloud_admin_app_password
NEXTCLOUD_TOTAL_CAPACITY=5000000000000 # 5.0 TB (in bytes)
