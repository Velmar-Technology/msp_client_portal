Windows
msiexec /i "https://cdn.zabbix.com/zabbix/binaries/stable/6.0/6.0.28/zabbix_agent2-6.0.28-windows-amd64-openssl.msi" /qn SERVER="zabbix.your-vps-domain.com" SERVERACTIVE="zabbix.your-vps-domain.com:10051" HOSTNAME="MSP-<DeviceName>"

Linux
wget https://repo.zabbix.com/zabbix/6.0/ubuntu/pool/main/z/zabbix-release/zabbix-release_6.0-4+ubuntu22.04_all.deb
dpkg -i zabbix-release_6.0-4+ubuntu22.04_all.deb
apt update && apt install -y zabbix-agent2
sed -i 's/Server=127.0.0.1/Server=zabbix.your-vps-domain.com/' /etc/zabbix/zabbix_agent2.conf
sed -i 's/ServerActive=127.0.0.1/ServerActive=zabbix.your-vps-domain.com:10051/' /etc/zabbix/zabbix_agent2.conf
sed -i 's/Hostname=Zabbix server/Hostname=MSP-<DeviceName>/' /etc/zabbix/zabbix_agent2.conf
systemctl restart zabbix-agent2
