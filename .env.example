# ============================================
# MSP Help Desk — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.

# ---- Database ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=msp_helpdesk
DB_USER=postgres
DB_PASSWORD=your_password_here

# ---- Server ----
PORT=3001
NODE_ENV=development

# ---- Initial Admin Credentials ----
ADMIN_EMAIL=admin@msp-helpdesk.com
ADMIN_PASSWORD=password123

# ---- JWT ----
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# ---- CORS ----
CORS_ORIGIN=http://localhost:5173

# ---- Email (Nodemailer) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# ---- WhatsApp (Stub — replace with Twilio/Meta API) ----
WHATSAPP_API_URL=https://api.whatsapp.example.com
WHATSAPP_API_KEY=your_api_key_here

# ---- File Uploads ----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=your_google_client_id_here

# ---- PayPal ----
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# ---- Nextcloud ----
NEXTCLOUD_URL=http://localhost:8080
NEXTCLOUD_APP_USER=your_nextcloud_username
NEXTCLOUD_APP_PASS=your_nextcloud_password
NEXTCLOUD_TOTAL_CAPACITY=5000000000000

# ---- Zabbix RMM ----
ZABBIX_URL=http://localhost:8080/api_jsonrpc.php
ZABBIX_USER=Admin
ZABBIX_PASSWORD=zabbix
ZABBIX_WEBHOOK_SECRET=your_zabbix_webhook_secret_here



