{
  "zabbixAgent": {
    "version": "6.0.28",
    "vpsDomain": "zabbix.your-vps-domain.com",
    "activePort": 10051,
    "platforms": {
      "windows": {
        "os": "Windows",
        "shell": "powershell",
        "msiUrl": "https://cdn.zabbix.com/zabbix/binaries/stable/6.0/6.0.28/zabbix_agent2-6.0.28-windows-amd64-openssl.msi",
        "commandTemplate": "msiexec /i \"https://cdn.zabbix.com/zabbix/binaries/stable/6.0/6.0.28/zabbix_agent2-6.0.28-windows-amd64-openssl.msi\" /qn SERVER=\"{{ZABBIX_SERVER}}\" SERVERACTIVE=\"{{ZABBIX_SERVER}}:{{ZABBIX_PORT}}\" HOSTNAME=\"MSP-{{DEVICE_NAME}}\""
      },
      "linux": {
        "os": "Linux (Ubuntu / Debian)",
        "shell": "bash",
        "commandSteps": [
          "wget https://repo.zabbix.com/zabbix/6.0/ubuntu/pool/main/z/zabbix-release/zabbix-release_6.0-4+ubuntu22.04_all.deb",
          "dpkg -i zabbix-release_6.0-4+ubuntu22.04_all.deb",
          "apt update && apt install -y zabbix-agent2",
          "sed -i 's/Server=127.0.0.1/Server={{ZABBIX_SERVER}}/' /etc/zabbix/zabbix_agent2.conf",
          "sed -i 's/ServerActive=127.0.0.1/ServerActive={{ZABBIX_SERVER}}:{{ZABBIX_PORT}}/' /etc/zabbix/zabbix_agent2.conf",
          "sed -i 's/Hostname=Zabbix server/Hostname=MSP-{{DEVICE_NAME}}/' /etc/zabbix/zabbix_agent2.conf",
          "systemctl restart zabbix-agent2"
        ],
        "commandTemplate": "wget https://repo.zabbix.com/zabbix/6.0/ubuntu/pool/main/z/zabbix-release/zabbix-release_6.0-4+ubuntu22.04_all.deb && dpkg -i zabbix-release_6.0-4+ubuntu22.04_all.deb && apt update && apt install -y zabbix-agent2 && sed -i 's/Server=127.0.0.1/Server={{ZABBIX_SERVER}}/' /etc/zabbix/zabbix_agent2.conf && sed -i 's/ServerActive=127.0.0.1/ServerActive={{ZABBIX_SERVER}}:{{ZABBIX_PORT}}/' /etc/zabbix/zabbix_agent2.conf && sed -i 's/Hostname=Zabbix server/Hostname=MSP-{{DEVICE_NAME}}/' /etc/zabbix/zabbix_agent2.conf && systemctl restart zabbix-agent2"
      }
    }
  }
}
