{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./src",
    "paths": {
      "@shared/contracts": ["../../packages/contracts/dist/cjs/index.d.ts"],
      "@shared/errors": ["../../packages/errors/dist/cjs/index.d.ts"],
      "@/*": ["./*"],
      "@shared/*": ["shared/*"],
      "@modules/*": ["modules/*"]
    },
    "types": ["node", "vitest/globals"],
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
