{
  "name": "msp-services-server",
  "version": "1.11.9",
  "description": "MSP Help Desk — Backend API Server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:email": "tsx src/scripts/testEmail.ts",
    "db:migrate": "tsx src/shared/db/migrate.ts",
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "db:seed": "tsx src/shared/db/seed.ts",
    "db:seed:faker": "tsx src/shared/db/seedFaker.ts",
    "db:seed:technicians": "tsx src/shared/db/seedTechnicians.ts",
    "db:reset": "tsx src/shared/db/reset.ts",
    "sentinel:audit": "tsx src/modules/system/sentinel/cli.ts"
  },
  "dependencies": {
    "@shared/contracts": "*",
    "@shared/errors": "*",
    "bcrypt": "5.1.1",
    "cors": "2.8.5",
    "dd-trace": "5.0.0",
    "dotenv": "16.4.7",
    "drizzle-orm": "0.45.2",
    "express": "5.1.0",
    "google-auth-library": "10.7.0",
    "helmet": "8.1.0",
    "ioredis": "6.0.0",
    "jsonwebtoken": "9.0.2",
    "multer": "1.4.5-lts.2",
    "nodemailer": "6.9.16",
    "pdfkit": "0.20.2",
    "pg": "8.13.3",
    "prom-client": "15.1.3",
    "swagger-jsdoc": "6.2.8",
    "swagger-ui-express": "5.0.1",
    "uuid": "11.1.0",
    "winston": "3.17.0",
    "ws": "8.21.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@types/bcrypt": "5.0.2",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.2",
    "@types/ioredis": "4.28.10",
    "@types/jsonwebtoken": "9.0.9",
    "@types/multer": "1.4.12",
    "@types/node": "22.15.0",
    "@types/nodemailer": "6.4.17",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.11.11",
    "@types/supertest": "7.2.1",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.8",
    "@types/uuid": "10.0.0",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "8.30.0",
    "@typescript-eslint/parser": "8.30.0",
    "@vitest/coverage-v8": "3.2.6",
    "drizzle-kit": "0.31.10",
    "eslint": "9.24.0",
    "supertest": "7.2.2",
    "tsup": "8.4.0",
    "tsx": "^4.23.12",
    "typescript": "5.7.3",
    "vitest": "3.2.6"
  }
}
